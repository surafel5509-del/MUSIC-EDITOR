{
  "kind": "Project",
  "id": "template-podcast",
  "name": "Podcast (2 voices)",
  "template": "PODCAST",
  "tempoMap": { "markers": [ { "bar": 0.0, "bpm": 120.0, "curve": "STEP" } ] },
  "timeSignature": { "numerator": 4, "beatUnit": 4 },
  "key": { "tonicPc": 0, "scale": "MAJOR" },
  "sampleRate": 48000,
  "bitDepth": "PCM_24",
  "tracks": [
    { "id": "tpl-host", "name": "Host", "type": "AUDIO", "color": "SKY", "orderIndex": 0,
      "input": { "armed": true, "monitorMode": "AUTO", "inputGainDb": 0 },
      "inserts": [
        { "id": "tpl-host-hp", "plugin": "HIGH_PASS", "params": { "0": 90 }, "enabled": true },
        { "id": "tpl-host-comp", "plugin": "COMPRESSOR", "params": { "0": -24, "1": 3, "2": 10, "3": 160 }, "enabled": true },
        { "id": "tpl-host-deess", "plugin": "DE_ESSER", "params": { "0": 6500, "1": -30 }, "enabled": true }
      ] },
    { "id": "tpl-guest", "name": "Guest", "type": "AUDIO", "color": "LIME", "orderIndex": 1,
      "input": { "armed": false, "monitorMode": "AUTO" },
      "inserts": [
        { "id": "tpl-guest-hp", "plugin": "HIGH_PASS", "params": { "0": 90 }, "enabled": true },
        { "id": "tpl-guest-comp", "plugin": "COMPRESSOR", "params": { "0": -24, "1": 3, "2": 10, "3": 160 }, "enabled": true }
      ] },
    { "id": "tpl-bed", "name": "Music Bed", "type": "AUDIO", "color": "SLATE", "orderIndex": 2,
      "volumeDb": -18 }
  ],
  "buses": [ { "id": "master", "name": "Master", "kind": "MASTER" } ],
  "durationBars": 512.0
}
